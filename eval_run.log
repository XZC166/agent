\n    resolveNearWallCells false;\n\n    // Region-wise refinement\n    // ~~~~~~~~~~~~~~~~~~~~~~\n\n    // Specifies two levels for every region. The first is the minimum level,\n    // the second is the maximum. The minimum level is used for cells intersecting\n    // the surface. The maximum level is used for cells inside the surface or\n    // close to the surface.\n    refinementRegions\n    {\n    }\n\n    // Mesh selection\n    // ~~~~~~~~~~~~~~\n\n    // After refinement patches get added for all refinementSurfaces and\n    // all cells intersecting the surfaces get put into these patches. The\n    // section simply specifies refinement and final mesh options for these\n    // patches.\n    patchInfo\n    {\n    }\n\n    // Location in mesh. This is the region of initial mesh that will be\n    // refined. Most likely the location that is on the surface of the\n    // geometry.\n    locationInMesh (1 1 1);\n\n    // Allow some cells to be outside the geometry. Useful for complex\n    // geometries where it's difficult to ensure the entire domain is\n    // inside the geometry.\n    allowFreeStandingZoneFaces true;\n}\n\n// Settings for the snapping.\nsnapControls\n{\n    nSmoothPatch 3;\n    tolerance 2.0;\n    nSolveIter 30;\n    nRelaxIter 5;\n    nFeatureSnapIter 10;\n    implicitFeatureSnap false;\n    explicitFeatureSnap true;\n    multiRegionFeatureSnap false;\n}\n\n// Settings for the layer addition.\naddLayersControls\n{\n    relativeSizes true;\n    layers {};\n    expansionRatio 1.0;\n    finalLayerThickness 0.3;\n    minThickness 0.1;\n    nGrow 0;\n    featureAngle 30;\n    slipFeatureAngle 30;\n    nRelaxIter 3;\n    nSmoothSurfaceNormals 1;\n    nSmoothNormals 3;\n    nSmoothThickness 10;\n    maxFaceThicknessRatio 0.5;\n    maxThicknessToMedialRatio 0.3;\n    minMedianAxisAngle 90;\n    nBufferCellsNoExtrude 0;\n    nLayerIter 50;\n}\n\n// Generic mesh quality settings. At any time you can check with\n//   checkMesh -extended\n// Mesh quality requirements are set low to allow for smooth meshing\nmeshQualityControls\n{\n    maxNonOrtho 65;\n    maxBoundarySkewness 20;\n    maxInternalSkewness 4;\n    maxConcave 80;\n    minVol 1e-13;\n    minTetQuality 1e-15;\n    minArea -1;\n    minTwist 0.02;\n    minDeterminant 0.001;\n    minFaceWeight 0.05;\n    minVolRatio 0.01;\n    minTriangleTwist -1;\n    nSmoothScale 4;\n    errorReduction 0.75;\n    relaxed\n    {\n        maxNonOrtho 75;\n    }\n}\n\n// Advanced\n// ~~~~~~~~\n\n// Switch for parallel running\n// Do not change unless you know what you are doing\n// Note: This setting is ignored when running in parallel\n// It is only used when running in serial\n//parallel\n//{\n//    nProcs 1;\n//}\n\n// ************************************************************************* //"}[0m[33;1m[1;3mSuccessfully wrote to file: /tmp/agent_eval_Q002_1775126949/system/snappyHexMeshDict[0m[32;1m[1;3mNow I need to create the surfaceFeaturesDict file, which is required when using snappyHexMesh even for a minimal case.

