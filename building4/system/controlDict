FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     blastFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.001;
deltaT          1e-7;
writeControl    timeStep;
writeInterval   100;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (p U);
        probeLocations  ((1.5 1.5 0.5) (5 0.5 0.5) (5 5 0.5));
    }
}